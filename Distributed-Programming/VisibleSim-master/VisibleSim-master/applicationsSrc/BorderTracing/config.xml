<?xml version="1.0" standalone="no" ?>
<world gridSize="11,8,1">
	<camera target="5,4,0" directionSpherical="-90,89,20" angle="45"/>
	<!-- Neon green blocks for a retro Space Invader -->
	<blockList color="0,255,0,255" blockSize="1,1,1">

		<!-- Row 0 (Feet) -->
		<block position="2,0,0"/> <block position="3,0,0"/>
		<block position="7,0,0"/> <block position="8,0,0"/>

		<!-- Row 1 (Lower arms/legs) -->
		<block position="0,1,0"/> <block position="2,1,0"/>
		<block position="8,1,0"/> <block position="10,1,0"/>

		<!-- Row 2 -->
		<block position="0,2,0"/>
		<block position="2,2,0"/> <block position="3,2,0"/> <block position="4,2,0"/>
		<block position="5,2,0"/> <block position="6,2,0"/> <block position="7,2,0"/> <block position="8,2,0"/>
		<block position="10,2,0"/>

		<!-- Row 3 (Solid midsection - long horizontal edge for collinear testing) -->
		<block position="0,3,0"/> <block position="1,3,0"/> <block position="2,3,0"/>
		<block position="3,3,0"/> <block position="4,3,0"/> <block position="5,3,0"/>
		<block position="6,3,0"/> <block position="7,3,0"/> <block position="8,3,0"/>
		<block position="9,3,0"/> <block position="10,3,0"/>

		<!-- Row 4 (Face with isolated holes at x=3 and x=7 for the eyes) -->
		<block position="0,4,0"/> <block position="1,4,0"/> <block position="2,4,0"/>
		<!-- x=3 is an internal border -->
		<block position="4,4,0"/> <block position="5,4,0"/> <block position="6,4,0"/>
		<!-- x=7 is an internal border -->
		<block position="8,4,0"/> <block position="9,4,0"/> <block position="10,4,0"/>

		<!-- Row 5 (Upper head) -->
		<block position="1,5,0"/> <block position="2,5,0"/> <block position="3,5,0"/>
		<block position="4,5,0"/> <block position="5,5,0"/> <block position="6,5,0"/>
		<block position="7,5,0"/> <block position="8,5,0"/> <block position="9,5,0"/>

		<!-- Row 6 (Top head) -->
		<block position="2,6,0"/> <block position="3,6,0"/> <block position="4,6,0"/>
		<block position="5,6,0"/> <block position="6,6,0"/> <block position="7,6,0"/> <block position="8,6,0"/>

		<!-- Row 7 (Antennas) -->
		<block position="2,7,0"/> <block position="3,7,0"/>
		<block position="7,7,0"/> <block position="8,7,0"/>

	</blockList>
</world>